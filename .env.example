# Kopirajte v .env za lokalni razvoj. Datoteka .env je v .gitignore in se nikoli ne objavi.

# PostgreSQL (lokalno: `npm run db:up` zažene bazo v Dockerju na portu 5433)
DATABASE_URL=postgresql://taskmaster:taskmaster@localhost:5433/taskmaster
# Neposredna povezava za migracije (pri Neon/Vercel Postgres je to DATABASE_URL_UNPOOLED)
# DATABASE_URL_UNPOOLED=

# Vsaj 32 naključnih znakov, npr.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Neobvezno
# PORT=8001
# SESSION_DAYS=7
# DB_POOL_MAX=10
# ALLOW_REGISTRATION=true
# APP_TIMEZONE=Europe/Ljubljana

# Ločena baza za avtomatske teste (teste brišejo podatke!)
TEST_DATABASE_URL=postgresql://taskmaster:taskmaster@localhost:5433/taskmaster_test
